---
/**
 * A screenshot or clip recorded from the app (apps/desktop/scripts/docs-media), in the
 * reader's theme. The id is a shot in shots/<chapter>.mjs; an unknown id fails the build.
 *
 *   <Media id="timeline-overview" alt="The timeline under the field, with pages 1 to 7" />
 *   <Media id="move-drag" alt="..." caption="Dragging a move's right edge to make it longer" />
 *
 * Stills are WebP; clips are short silent loops that play when they scroll into view and
 * respect reduced motion (they show a still with controls instead).
 */
import manifest from "../../data/docs-media.json";

interface Props {
    /** The shot's id */
    id: string;
    /** What the image shows, for screen readers and when it can't load */
    alt: string;
    /** A short line under the image, when the text around it doesn't explain it */
    caption?: string;
    /** Show it smaller than the column (a small control), in CSS pixels */
    maxWidth?: number;
}

const { id, alt, caption, maxWidth } = Astro.props;
const entry = (
    manifest as Record<
        string,
        {
            chapter: string;
            kind: "still" | "clip";
            width: number;
            height: number;
        }
    >
)[id];
if (!entry)
    throw new Error(
        `<Media id="${id}">: no such shot. Add it to apps/desktop/scripts/docs-media/shots/ and run pnpm --dir apps/desktop docs:media ${id}`,
    );
const base = `/docs/media/${entry.chapter}/${id}`;
// Media is captured at 2x: show it at half its pixel width, never wider than the column
const cssWidth = Math.round(entry.width / 2);
const style = `max-width: min(100%, ${maxWidth ?? cssWidth}px)`;
---

<figure class="docs-media not-content" data-kind={entry.kind}>
    {
        entry.kind === "still" ? (
            <>
                <img
                    class="docs-media-light"
                    src={`${base}.light.webp`}
                    alt={alt}
                    width={entry.width}
                    height={entry.height}
                    loading="lazy"
                    decoding="async"
                    style={style}
                />
                <img
                    class="docs-media-dark"
                    src={`${base}.dark.webp`}
                    alt={alt}
                    width={entry.width}
                    height={entry.height}
                    loading="lazy"
                    decoding="async"
                    style={style}
                />
            </>
        ) : (
            <video
                class="docs-clip"
                data-base={base}
                poster={`${base}.light.webp`}
                width={entry.width}
                height={entry.height}
                muted
                loop
                playsinline
                preload="none"
                aria-label={alt}
                style={style}
            >
                <source src={`${base}.light.mp4`} type="video/mp4" />
                {alt}
            </video>
        )
    }
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
    .docs-media {
        margin: 1.25rem 0;
    }
    .docs-media img,
    .docs-media video {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 6px;
        border: 1px solid var(--sl-color-gray-5);
    }
    :global([data-theme="dark"]) .docs-media-light,
    :global([data-theme="light"]) .docs-media-dark,
    :global(:root:not([data-theme])) .docs-media-dark {
        display: none !important;
    }
    figcaption {
        margin-top: 0.4rem;
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-3);
    }
</style>

<script>
    // Clips follow the site's theme, play only while on screen, and stay still with
    // controls for readers who ask for reduced motion.
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const theme = () =>
        document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    function setSource(video: HTMLVideoElement) {
        const base = video.dataset.base;
        const want = `${base}.${theme()}.mp4`;
        const source = video.querySelector("source");
        if (!source || source.getAttribute("src") === want) return;
        const playing = !video.paused;
        source.setAttribute("src", want);
        video.poster = `${base}.${theme()}.webp`;
        video.load();
        if (playing) void video.play().catch(() => {});
    }
    const clips = [
        ...document.querySelectorAll<HTMLVideoElement>("video.docs-clip"),
    ];
    const seen = new IntersectionObserver(
        (entries) => {
            for (const e of entries) {
                const v = e.target as HTMLVideoElement;
                if (reduce.matches) continue;
                if (e.isIntersecting) void v.play().catch(() => {});
                else v.pause();
            }
        },
        { threshold: 0.4 },
    );
    for (const v of clips) {
        setSource(v);
        if (reduce.matches) v.controls = true;
        else seen.observe(v);
    }
    new MutationObserver(() => clips.forEach(setSource)).observe(
        document.documentElement,
        { attributes: true, attributeFilter: ["data-theme"] },
    );
</script>
