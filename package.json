{
    "name": "@openmarch/monorepo",
    "private": true,
    "packageManager": "pnpm@10.11.0",
    "funding": {
        "type": "patreon",
        "url": "https://www.patreon.com/c/openmarch"
    },
    "bugs": {
        "url": "https://github.com/OpenMarch/OpenMarch/issues",
        "email": "dev@openmarch.com"
    },
    "homepage": "https://openmarch.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/OpenMarch/OpenMarch.git"
    },
    "scripts": {
        "desktop": "turbo run --filter=@openmarch/desktop",
        "build": "turbo run build",
        "release": "pnpm run build && changeset version && changeset publish",
        "site": "turbo run --filter=@openmarch/website",
        "ui": "turbo run --filter=@openmarch/ui",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "lint:check": "turbo run lint:check",
        "check:agent-guidance": "node scripts/validate-agent-guidance.mjs",
        "check:quick": "pnpm format:check && pnpm lint:check && pnpm spellcheck && pnpm check:agent-guidance",
        "check:full": "pnpm check:quick && pnpm build && pnpm test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "fix": "turbo run fix",
        "spellcheck": "turbo run spellcheck && cspell .",
        "prepare": "husky"
    },
    "devDependencies": {
        "@tanstack/eslint-plugin-query": "^5.104.5",
        "@types/bun": "latest",
        "@types/sanitize-html": "^2.16.2",
        "@typescript-eslint/parser": "^8.72.0",
        "cspell": "^10.4.0",
        "eslint": "8.57.1",
        "eslint-config-react-app": "^7.0.1",
        "eslint-plugin-astro": "^1.3.1",
        "eslint-plugin-react": "^7.37.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "turbo": "^2.11.10"
    },
    "peerDependencies": {
        "typescript": "catalog:"
    },
    "pnpm": {
        "overrides": {
            "react": "^19.0.0",
            "react-dom": "^19.0.0",
            "@playwright/test": "1.64.1",
            "playwright": "1.64.1",
            "playwright-core": "1.64.1",
            "astro@<7.2.8": "^7.4.2",
            "dompurify@<3.4.17": "^3.4.17",
            "esbuild@<0.25.0": "^0.25.12",
            "glob@>=10.2.0 <10.5.0": "^10.5.0",
            "happy-dom@<21.0.4": "^21.0.4",
            "plist@3.1.0": "3.1.1",
            "postcss-selector-parser@<7.1.6": "^7.1.6",
            "tar@<7.5.21": "^7.5.21",
            "undici@>=7.0.0 <7.30.1": "^7.30.1",
            "yauzl": "^3.3.2"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "@yeskunall/astro-umami>astro": "7"
            }
        }
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@changesets/cli": "^3.0.3",
        "sanitize-html": "^2.18.1"
    }
}
