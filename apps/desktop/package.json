{
    "name": "@openmarch/desktop",
    "productName": "OpenMarch",
    "description": "Free drill-writing software for the marching arts",
    "version": "0.1.7",
    "main": "dist-electron/main/index.js",
    "author": "OpenMarch LLC <contact@openmarch.com>",
    "url": "https://openmarch.com",
    "license": "AGPL-3.0",
    "private": true,
    "debug": {
        "env": {
            "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/OpenMarch/OpenMarch.git"
    },
    "scripts": {
        "dev": "pnpm run apply-styles && vite",
        "build": "pnpm run apply-styles && tsc && vite build",
        "build:electron": "pnpm run apply-styles && tsc && vite build && electron-builder --dir",
        "clean": "rimraf node_modules dist-electron release",
        "apply-styles": "node src/styles/apply-tailwind-vars.cjs",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "format": "prettier --write .",
        "spellcheck": "cspell 'src/**' 'electron/**' '*.md'",
        "fix": "prettier --write . && eslint . --fix && cspell 'src/**' 'electron/**' '*.md'",
        "test": "vitest run --silent",
        "test:focused": "vitest run --silent=true",
        "test:history": "VITEST_ENABLE_HISTORY=true vitest run",
        "test:watch": "vitest",
        "test:coverage": "pnpm test -- --coverage",
        "test:clearCache": "vitest --clearCache",
        "e2e": "cross-env VITE_PUBLIC_PLAYWRIGHT_SESSION=true playwright test --project=electron",
        "build:browser": "pnpm run apply-styles && cross-env VITE_PUBLIC_PLAYWRIGHT_SESSION=true vite build -c vite.browser.config.mts && vite build -c vite.browser.config.mts --mode host",
        "e2e:browser": "playwright test --project=browser --workers=4",
        "e2e:scenarios:electron": "cross-env VITE_PUBLIC_PLAYWRIGHT_SESSION=true playwright test --project=electron-scenarios --workers=4",
        "e2e:codegen": "node e2e/_codegen.mjs",
        "web:dev": "pnpm run apply-styles && vite -c vite.web.config.mts",
        "web:build": "pnpm run apply-styles && rimraf dist-web && vite build -c vite.web.config.mts",
        "web:preview": "vite preview -c vite.web.config.mts",
        "check:gate": "tsc --noEmit && pnpm run test && pnpm run build:browser && pnpm run e2e:browser",
        "migrate": "export DATABASE_URL=file:electron/database/migrations/_blank.dots && drizzle-kit generate && tsx scripts/create-blank-db.ts"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource/dm-mono": "^5.3.0",
        "@fontsource/dm-sans": "^5.3.0",
        "@openmarch/core": "workspace:*",
        "@openmarch/metronome": "workspace:*",
        "@openmarch/musicxml-parser": "workspace:*",
        "@openmarch/schema": "0.4.2",
        "@openmarch/ui": "workspace:*",
        "@phosphor-icons/react": "^2.1.10",
        "@radix-ui/react-alert-dialog": "^1.2.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-collapsible": "^1.2.1",
        "@radix-ui/react-context-menu": "^2.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-form": "^0.3.0",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-radio-group": "^1.5.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@react-spring/web": "^10.1.2",
        "@sentry/electron": "^6.11.0",
        "@sentry/vite-plugin": "^3.6.1",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-query-devtools": "^5.104.5",
        "@tanstack/react-virtual": "^3.14.22",
        "@tiptap/extension-hard-break": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/react": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "@tolgee/format-icu": "^7.3.0",
        "@tolgee/react": "^7.3.0",
        "@uiw/react-color": "^2.10.3",
        "@uiw/react-color-sketch": "^2.10.3",
        "@uiw/react-color-swatch": "^2.10.3",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.17",
        "drizzle-orm": "^0.45.4",
        "electron-store": "^8.2.0",
        "electron-updater": "^6.8.11",
        "fabric": "^5.5.2",
        "jszip": "^3.10.2",
        "mediabunny": "^1.62.0",
        "nan": "^2.30.0",
        "pdfkit": "^0.17.2",
        "posthog-js": "^1.438.16",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "sanitize-html": "^2.18.1",
        "sonner": "^2.0.8",
        "svg-to-pdfkit": "^0.1.8",
        "tailwind-merge": "^3.7.0",
        "tinykeys": "^4.0.1",
        "uuid": "^14.0.3",
        "wavesurfer.js": "^8.0.3",
        "zod": "^4.6.7",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@electron/notarize": "^3.1.2",
        "@faker-js/faker": "^10.6.0",
        "@noble/hashes": "1.8.0",
        "@playwright/test": "1.64.1",
        "@sqlite.org/sqlite-wasm": "3.53.4-build1",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/fabric": "^5.3.10",
        "@types/node": "^24.19.2",
        "@types/pdfkit": "^0.13.9",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/sanitize-html": "^2.16.2",
        "@types/sql.js": "^1.4.11",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^4.1.12",
        "@vitest/ui": "^4.1.12",
        "canvas": "^3.2.3",
        "cross-env": "^10.1.0",
        "dotenv": "^16.6.1",
        "drizzle-kit": "^0.31.11",
        "electron": "^43.8.3",
        "electron-builder": "^26.18.0",
        "fast-check": "^4.10.2",
        "jsdom": "^24.1.3",
        "patch-package": "^8.0.1",
        "rimraf": "^5.0.10",
        "sql-formatter": "^15.9.0",
        "sql.js": "^1.15.1",
        "tailwindcss": "4.3.3",
        "tsx": "^4.23.15",
        "typescript": "catalog:",
        "vite": "^8.3.5",
        "vite-plugin-electron": "^0.29.1",
        "vite-plugin-electron-renderer": "^0.14.7",
        "vitest": "^4.1.12",
        "wrangler": "^4.152.0"
    },
    "engines": {
        "node": ">=24"
    }
}
