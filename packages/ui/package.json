{
    "name": "@openmarch/ui",
    "type": "module",
    "version": "1.1.2",
    "license": "AGPL-3.0",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "description": "UI components for OpenMarch applications",
    "homepage": "https://openmarch.com",
    "author": "OpenMarch LLC <contact@openmarch.com>",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/OpenMarch/OpenMarch.git"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./astro": {
            "types": "./src/astro.ts",
            "import": "./src/astro.ts",
            "default": "./src/astro.ts"
        },
        "./src/tailwind.css": {
            "default": "./src/tailwind.css"
        }
    },
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup --format esm,cjs",
        "playground": "astro dev",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "format": "prettier --write .",
        "spellcheck": "cspell 'src/**' 'electron/**' '*.md'",
        "fix": "prettier --write . && eslint . --fix && cspell 'src/**' 'electron/**' '*.md'"
    },
    "devDependencies": {
        "tsup": "^8.5.1",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@astrojs/mdx": "^4.3.0",
        "@astrojs/react": "^4.3.0",
        "@openmarch/config": "workspace:*",
        "@fontsource/dm-mono": "^5.3.0",
        "@fontsource/dm-sans": "^5.3.0",
        "@korhq/undocs": "0.4.1-alpha",
        "@korhq/unpreview": "0.1.2-alpha",
        "@phosphor-icons/react": "^2.1.10",
        "@radix-ui/react-alert-dialog": "^1.2.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-radio-group": "^1.5.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slider": "^1.6.1",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@uiw/react-color": "^2.10.3",
        "astro": "^6.3.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^2.6.1",
        "tailwindcss": "^4.3.3"
    }
}
